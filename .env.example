# ==============================================================================
# WaslShip Environment Variables Definition & Production Guide
# ==============================================================================
# In Development: Use SQLite / Local Storage by default, or connect to local Docker.
# In Production:  Use PostgreSQL + MinIO (or S3) with secure JWT and SSL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# development | production | test
NODE_ENV=development
PORT=3000
API_PREFIX=api

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# DB_TYPE: 'postgres' (for Docker / Production) or 'sqlite' (for dev without DB)
DB_TYPE=sqlite

# If DB_TYPE=postgres, configure the following:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres123
DB_DATABASE=waslship_db
# In Production: set DB_SYNCHRONIZE=false and use TypeORM migrations
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DB_LOGGING=false
DB_SSL=false

# Alternatively, specify a full connection string:
# DATABASE_URL=postgres://postgres:postgres123@localhost:5432/waslship_db

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# In Production: Generate a strong 64+ char random string (e.g. openssl rand -base64 48)
JWT_SECRET=waslship_super_secret_jwt_key_2026
JWT_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 4. STORAGE CONFIGURATION (MinIO / Local Disk / AWS S3)
# ------------------------------------------------------------------------------
# STORAGE_DRIVER: 'local' (Development) | 'minio' (Docker/Prod) | 's3' (Cloud)
STORAGE_DRIVER=local

# MinIO Settings (Used when STORAGE_DRIVER=minio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=waslship-media
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://localhost:9000/waslship-media

# ------------------------------------------------------------------------------
# 5. THIRD-PARTY LOGISTICS (OTO Logistics API)
# ------------------------------------------------------------------------------
OTO_BASE_URL=https://api.tryoto.com/rest/v2
OTO_REFRESH_TOKEN=
OTO_ACCESS_TOKEN=
OTO_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. FIREBASE CLOUD MESSAGING (FCM - Push Notifications)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
